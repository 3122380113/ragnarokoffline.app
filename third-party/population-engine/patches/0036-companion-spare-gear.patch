From 0000000000000000000000000000000000000036
Subject: [PATCH] @companion spare: a companion carries gear it does not wear

A companion that started unequipped (patch 0035) can carry pieces beside the ones it wears:
"@companion spare <name> stow <slot>" moves a worn piece into its bag, "wear <#>" puts a carried
one on, "take <#>" hands one back, "list" shows both. The command is one line here; all of it
is in population_engine/runtime/population_shell_gear. The Companions window's Gear tab sends
these. It needs Companion inventory, which is what saves the bag.

diff --git a/src/custom/atcommand.inc b/src/custom/atcommand.inc
--- a/src/custom/atcommand.inc
+++ b/src/custom/atcommand.inc
@@ -719,6 +719,13 @@
 		clif_displaymessage(fd, msg);
 		return 0;
 	}
+	// RAGNAROKMAC (spare gear): what a companion that started unequipped carries beside what
+	// it wears ("@companion spare <name> list | stow <slot> | wear <#> | take <#>"). All of it
+	// is in population_shell_gear; the Companions window's Gear tab sends these.
+	if (strcmpi(cmd, "spare") == 0) {
+		population_shell_gear_command(sd, param);
+		return 0;
+	}
 	// RAGNAROKMAC (rest): when companions sit down to rest between fights
 	// ("@companion rest <below%> <until%>"), for the whole party like the healer
 	// thresholds, and stored per companion row the same way. 0 below = never.
@@ -772,7 +779,7 @@
 		clif_displaymessage(fd, reply[0] ? reply : "Could not set that companion's homunculus.");
 		return 0;
 	}
-	clif_displaymessage(fd, "Usage: @companion list | summon <name> | draft <job> [name] [m|f] | jobs | skills <name> [list|none|auto] | favorite <name> | remove <name> | dismiss <name> | gear <name> [slots] | heal <a%> <b%> | rest <a%> <b%> | homunculus <name> [on|off]");
+	clif_displaymessage(fd, "Usage: @companion list | summon <name> | draft <job> [name] [m|f] | jobs | skills <name> [list|none|auto] | favorite <name> | remove <name> | dismiss <name> | gear <name> [slots] | heal <a%> <b%> | spare <name> list|stow|wear|take | rest <a%> <b%> | homunculus <name> [on|off]");
 	return -1;
 }
 
diff --git a/src/map/atcommand.cpp b/src/map/atcommand.cpp
--- a/src/map/atcommand.cpp
+++ b/src/map/atcommand.cpp
@@ -55,6 +55,7 @@
 #include "population_engine.hpp"
 #include "population_engine/core/pe_perf.hpp"
 #include "population_engine/runtime/population_engine_path.hpp"
+#include "population_engine/runtime/population_shell_gear.hpp"
 #include "quest.hpp"
 #include "script.hpp"
 #include "storage.hpp"
